# Labels for P3 issues the review gate and Codex file (claude-ship's p3-issue.sh reads this from main).
# Every matching rule adds its labels; a later rule's area: replaces an earlier one, so overrides go last.
*                                   priority:p3,status:ready
*.md                                area:docs,documentation
docs/*                              area:docs,documentation
frontend/*                          area:legacy
server.js                           area:legacy
routes/*                            area:legacy
models/*                            area:legacy
middleware/*                        area:legacy
services/*                          area:legacy
config/*                            area:legacy
tests/*                             area:legacy
.github/*                           area:ci
scripts/*                           area:ci
scripts/deploy*                     area:deploy
deploy/*                            area:deploy
contracts/*                         area:core
server/*                            area:api
server/src/ActionJackson.Core/*     area:core
server/tests/ActionJackson.Core.Tests/*  area:core
server/src/ActionJackson.Data/*     area:data
server/tests/ActionJackson.Data.Tests/*  area:data
server/src/ActionJackson.Edge/*     area:edge
server/tests/ActionJackson.Edge.Tests/*  area:edge
apps/web/*                          area:web
