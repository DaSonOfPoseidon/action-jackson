{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "main": {
      "projectType": "application",
      "root": "projects/main",
      "sourceRoot": "projects/main/src",
      "prefix": "aj",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/main/src/main.ts",
            "tsConfig": "projects/main/tsconfig.app.json",
            "index": "projects/main/src/index.html",
            "styles": [
              "projects/shared/src/styles/base.css",
              "projects/main/src/styles.css"
            ],
            "security": {
              "autoCsp": false
            },
            "server": "projects/main/src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/main/tsconfig.spec.json"
          }
        }
      }
    },
