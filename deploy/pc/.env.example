# Copy to deploy/pc/.env (git-ignored) and fill every value; scripts/deploy.sh pc refuses an empty one.
# Never commit deploy/pc/.env.

# Postgres password for the action_jackson user.   openssl rand -hex 24
POSTGRES_PASSWORD=

# Redis password (Redis is a cache only).   openssl rand -hex 24
REDIS_PASSWORD=

# Edge key: the API trusts X-Client-IP only on a request that carries this value in X-Edge-Key. Use at least
# 32 characters; the edge (unit 9) sends the same value.   openssl rand -hex 32
EDGE_KEY=

# Garage RPC secret; Garage requires exactly 64 hex characters.   openssl rand -hex 32
GARAGE_RPC_SECRET=

# Garage admin API token.   openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# Garage metrics token.   openssl rand -base64 32
GARAGE_METRICS_TOKEN=

# S3 access key ID the API uses; Garage requires "GK" followed by 24 hex characters.   echo GK$(openssl rand -hex 12)
S3_ACCESS_KEY_ID=

# S3 secret access key for that ID; Garage requires 64 hex characters.   openssl rand -hex 32
S3_SECRET_ACCESS_KEY=

# Optional: the host port the API publishes on 192.168.1.195. Empty means 8110.
AJ_API_PORT=

# Optional: email delivery (issue #15). Leave SMTP_HOST empty and nothing is sent: emails the site queues wait
# in the database (core.email_outbox) and go out once SMTP_HOST is set and the stack is redeployed. Setting
# SMTP_HOST also requires EMAIL_FROM. Empty values here never stop scripts/deploy.sh.
# The SMTP server; empty turns delivery off.
SMTP_HOST=
# Its port. Empty means 587.
SMTP_PORT=
# StartTls (port 587, the default), SslOnConnect (port 465) or None (no encryption; only without SMTP_USERNAME).
SMTP_SECURITY=
# The login, when the server needs one. Setting it requires SMTP_PASSWORD.
SMTP_USERNAME=
# The login's password: a secret, ideally an app password. Never commit deploy/pc/.env.
SMTP_PASSWORD=
# The sender of every email, e.g. Action Jackson <noreply@example.com>. Required when SMTP_HOST is set.
EMAIL_FROM=
# Where admin notifications (new consultation, quote, booking) go. Empty means they are not queued.
EMAIL_ADMIN_ADDRESS=
