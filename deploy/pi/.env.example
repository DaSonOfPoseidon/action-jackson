# deploy/pi/.env is written by scripts/deploy.sh pi, on the Pi, from deploy/pc/.env: you never create it by hand.
# This file documents what it holds. Never commit a real .env.

# Edge key: the API trusts X-Client-IP only on a request that carries this value in X-Edge-Key. It is the same
# value as EDGE_KEY in deploy/pc/.env, which scripts/deploy.sh pi reads, so the two cannot drift.   openssl rand -hex 32
EDGE_KEY=

# Optional: the API's address as the edge reaches it. Empty means http://192.168.1.195:8110. scripts/deploy.sh pi
# fills it from AJ_API_PORT in deploy/pc/.env, or from AJ_API_URL in its environment.
AJ_API_URL=

# Optional: the host port of the LAN listener on 192.168.1.69. Empty means 8180.
AJ_EDGE_PORT=

# Optional: the host port of the tunnel listener on 127.0.0.1 (cloudflared points here at the cutover). Empty means 8181.
AJ_TUNNEL_PORT=
